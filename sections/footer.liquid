{%- liquid
  assign footer_menu = linklists['web-footer']
  if footer_menu == blank or footer_menu.links.size == 0
    assign footer_menu = linklists[section.settings.menu]
  endif
  if footer_menu == blank or footer_menu.links.size == 0
    assign footer_menu = linklists['footer']
  endif

  assign has_nested = false
  if footer_menu != blank
    for link in footer_menu.links
      if link.links.size > 0
        assign has_nested = true
        break
      endif
    endfor
  endif
-%}

{%- style -%}
  .afrozeh-custom-footer {
    background-color: #000000 !important;
    color: #ffffff !important;
    padding: 70px 0 50px 0 !important;
    font-family: inherit;
    position: relative;
    z-index: 10;
  }
  .afrozeh-footer-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }
  
  /* Newsletter Section */
  .afrozeh-newsletter-wrap {
    text-align: center;
    max-width: 760px !important;
    width: 100% !important;
    margin: 0 auto 64px auto !important;
  }
  .afrozeh-newsletter-title,
  .afrozeh-custom-footer h2,
  .afrozeh-custom-footer h2.afrozeh-newsletter-title {
    font-size: {{ section.settings.newsletter_heading_size | default: 14 }}px !important;
    font-weight: 500 !important;
    letter-spacing: 4px !important;
    text-transform: uppercase !important;
    color: #ffffff !important;
    margin-bottom: 12px !important;
    line-height: 1.2 !important;
  }
  .afrozeh-newsletter-sub {
    font-size: 12px !important;
    color: #cccccc !important;
    margin-bottom: 30px !important;
    font-weight: 300 !important;
  }
  .afrozeh-newsletter-form {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0;
    max-width: 700px !important;
    width: 100% !important;
    margin: 0 auto;
  }
  .afrozeh-newsletter-input {
    flex: 1 1 auto !important;
    width: 100% !important;
    height: 48px;
    background: #000000 !important;
    border: 1px solid #333333 !important;
    border-right: none !important;
    padding: 0 20px !important;
    color: #ffffff !important;
    font-size: 14px !important;
    outline: none !important;
    box-sizing: border-box !important;
    border-radius: 0 !important;
  }
  .afrozeh-newsletter-input::placeholder {
    color: #777777 !important;
  }
  .afrozeh-newsletter-input:focus {
    border-color: #666666 !important;
  }
  .afrozeh-newsletter-btn {
    height: 48px !important;
    padding: 0 34px !important;
    background-color: #ffffff !important;
    color: #000000 !important;
    border: 1px solid #ffffff !important;
    font-size: 13px !important;
    font-weight: 600 !important;
    letter-spacing: 2px !important;
    text-transform: uppercase !important;
    cursor: pointer !important;
    transition: all 0.2s ease !important;
    white-space: nowrap !important;
    box-sizing: border-box !important;
    border-radius: 0 !important;
  }
  .afrozeh-newsletter-btn:hover {
    background-color: #e2e2e2 !important;
    border-color: #e2e2e2 !important;
  }

  /* Columns Grid */
  .afrozeh-footer-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
  }
  .afrozeh-footer-col {
    display: flex;
    flex-direction: column;
  }
  .afrozeh-col-title,
  .afrozeh-custom-footer h3,
  .afrozeh-custom-footer h3.afrozeh-col-title {
    font-size: {{ section.settings.col_heading_size | default: 14 }}px !important;
    font-weight: 600 !important;
    letter-spacing: 1.8px !important;
    text-transform: uppercase !important;
    color: #ffffff !important;
    margin-bottom: 22px !important;
  }
  .afrozeh-footer-links {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }
  .afrozeh-footer-links li {
    margin-bottom: 12px !important;
    list-style: none !important;
  }
  .afrozeh-footer-links a {
    color: #cccccc !important;
    text-decoration: none !important;
    font-size: 12px !important;
    font-weight: 400 !important;
    letter-spacing: 0.3px !important;
    transition: color 0.2s ease !important;
    display: inline-block !important;
  }
  .afrozeh-footer-links a:hover {
    color: #ffffff !important;
  }

  /* Contact List */
  .afrozeh-contact-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .afrozeh-contact-item {
    display: flex !important;
    align-items: flex-start !important;
    gap: 12px !important;
    color: #cccccc !important;
    font-size: 12px !important;
    line-height: 1.55 !important;
    letter-spacing: 0.3px !important;
  }
  .afrozeh-contact-item span,
  .afrozeh-contact-item a {
    font-size: 12px !important;
  }
  .afrozeh-contact-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 2px;
    stroke: #ffffff;
    fill: none;
  }
  .afrozeh-contact-item a {
    color: #cccccc !important;
    text-decoration: none !important;
    transition: color 0.2s ease !important;
  }
  .afrozeh-contact-item a:hover {
    color: #ffffff !important;
  }

  /* Responsive breakpoints */
  @media (max-width: 991px) and (min-width: 768px) {
    .afrozeh-footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 36px;
    }
  }
  @media (max-width: 767px) {
    .afrozeh-footer-grid {
      display: flex !important;
      flex-direction: column !important;
      gap: 0 !important;
    }
    .afrozeh-footer-col {
      border-bottom: 1px solid #222222 !important;
      padding: 16px 0 !important;
    }
    .afrozeh-footer-col:first-child {
      border-top: 1px solid #222222 !important;
    }
    .afrozeh-col-title,
    .afrozeh-custom-footer h3,
    .afrozeh-custom-footer h3.afrozeh-col-title {
      margin-bottom: 0 !important;
      display: flex !important;
      justify-content: space-between !important;
      align-items: center !important;
      cursor: pointer !important;
      user-select: none !important;
      padding: 4px 0 !important;
    }
    .afrozeh-col-title::after {
      content: '+' !important;
      font-size: 18px !important;
      font-weight: 300 !important;
      color: #ffffff !important;
      line-height: 1 !important;
    }
    .afrozeh-footer-col.is-open .afrozeh-col-title::after {
      content: '–' !important;
    }
    .afrozeh-custom-footer .afrozeh-footer-col:not(.is-open) .afrozeh-footer-links,
    .afrozeh-custom-footer .afrozeh-footer-col:not(.is-open) .afrozeh-contact-list {
      display: none !important;
    }
    .afrozeh-custom-footer .afrozeh-footer-col.is-open .afrozeh-footer-links,
    .afrozeh-custom-footer .afrozeh-footer-col.is-open .afrozeh-contact-list {
      display: block !important;
      padding-top: 14px !important;
      padding-bottom: 8px !important;
    }
    .afrozeh-newsletter-form {
      flex-direction: column;
      gap: 12px;
    }
    .afrozeh-newsletter-input {
      width: 100% !important;
      border-right: 1px solid #333333 !important;
    }
    .afrozeh-newsletter-btn {
      width: 100% !important;
    }
  }
{%- endstyle -%}

<footer class="afrozeh-custom-footer" {{ block.shopify_attributes }}>
  <div class="afrozeh-footer-inner">
    
    <!-- Newsletter Section -->
    <div class="afrozeh-newsletter-wrap">
      <h2 class="afrozeh-newsletter-title">NEWSLETTER</h2>
      <p class="afrozeh-newsletter-sub">Subscribe us and get more exciting offers and updates.</p>
      {% form 'customer', class: 'afrozeh-newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" class="afrozeh-newsletter-input" placeholder="E-mail" required autocomplete="email">
        <button type="submit" class="afrozeh-newsletter-btn">SUBSCRIBE</button>
      {% endform %}
    </div>

    <!-- Columns Grid -->
    <div class="afrozeh-footer-grid">
      {%- if footer_menu != blank and footer_menu.links.size > 0 -%}
        {%- if has_nested -%}
          {%- for link in footer_menu.links -%}
            <div class="afrozeh-footer-col">
              <h3 class="afrozeh-col-title">{{ link.title }}</h3>
              {%- if link.links != blank and link.links.size > 0 -%}
                <ul class="afrozeh-footer-links">
                  {%- for child_link in link.links -%}
                    <li><a href="{{ child_link.url }}">{{ child_link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Flat menu: distribute items into 3 columns {%- endcomment -%}
          {%- assign total_links = footer_menu.links.size -%}
          {%- assign per_col = total_links | divided_by: 3.0 | ceil -%}
          {%- for i in (0..2) -%}
            {%- assign start_index = i | times: per_col -%}
            {%- if start_index < total_links -%}
              <div class="afrozeh-footer-col">
                <ul class="afrozeh-footer-links">
                  {%- for link in footer_menu.links offset: start_index limit: per_col -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- else -%}
        <!-- Fallback static columns -->
        <div class="afrozeh-footer-col">
          <h3 class="afrozeh-col-title">WE - I.S</h3>
          <ul class="afrozeh-footer-links">
            <li><a href="/pages/afrozeh-history">Afrozeh History</a></li>
            <li><a href="/pages/store-locator">Store Locator</a></li>
            <li><a href="/pages/contact">Contact</a></li>
            <li><a href="/pages/faqs">FAQs</a></li>
            <li><a href="/blogs/news">Blogs</a></li>
          </ul>
        </div>
        <div class="afrozeh-footer-col">
          <h3 class="afrozeh-col-title">I.S POLICIES</h3>
          <ul class="afrozeh-footer-links">
            <li><a href="/pages/cancellation-policy">Cancellation Policy</a></li>
            <li><a href="/pages/return-exchange-policy">Return &amp; Exchange Policy</a></li>
            <li><a href="/pages/shipping-policy">Shipping Policy</a></li>
            <li><a href="/pages/terms-of-service">Terms of Service</a></li>
            <li><a href="/pages/care-instructions">Care Instructions</a></li>
            <li><a href="/pages/privacy-policy">Privacy Policy</a></li>
          </ul>
        </div>
        <div class="afrozeh-footer-col">
          <h3 class="afrozeh-col-title">INFORMATION</h3>
          <ul class="afrozeh-footer-links">
            <li><a href="/collections/mulaqaat-26">Mulaqaat'26</a></li>
            <li><a href="/collections/sunspell-26">Sunspell'26</a></li>
            <li><a href="/collections/florette-26">Florette'26</a></li>
            <li><a href="/collections/day-break-26">Day Break'26</a></li>
            <li><a href="/collections/summer-together-26">Summer Together'26</a></li>
            <li><a href="/collections/hayat-25">Hayat'25</a></li>
            <li><a href="/collections/divani-silk-edit-25">Divani Silk Edit'25</a></li>
          </ul>
        </div>
      {%- endif -%}

      <!-- Contact Column: HOW CAN WE HELP YOU? -->
      <div class="afrozeh-footer-col">
        <h3 class="afrozeh-col-title">HOW CAN WE HELP YOU?</h3>
        <div class="afrozeh-contact-list">
          <div class="afrozeh-contact-item">
            <svg class="afrozeh-contact-icon" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>GNA Textiles (PVT) Limited T/A Awais Fancy Embroidery Factory, #4, Defence Kacha Road, Opp, ATS Factory, Lahore</span>
          </div>
          <div class="afrozeh-contact-item">
            <svg class="afrozeh-contact-icon" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <a href="tel:+923041116364">+923041116364</a>
          </div>
          <div class="afrozeh-contact-item">
            <svg class="afrozeh-contact-icon" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
            <a href="https://wa.me/9230188888264" target="_blank" rel="noopener">+9230188888264</a>
          </div>
          <div class="afrozeh-contact-item">
            <svg class="afrozeh-contact-icon" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
            <a href="https://wa.me/923014786853" target="_blank" rel="noopener">+923014786853</a>
          </div>
          <div class="afrozeh-contact-item">
            <svg class="afrozeh-contact-icon" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>9:00 am – 5:00 pm (Mon - Sat)</span>
        </div>
      </div>

    </div>
  </div>
</footer>

<script>
  document.addEventListener('click', function(e) {
    if (window.innerWidth >= 768) return;
    var title = e.target.closest('.afrozeh-col-title, .afrozeh-custom-footer h3');
    if (title) {
      e.preventDefault();
      var col = title.closest('.afrozeh-footer-col');
      if (col) {
        var isOpen = col.classList.contains('is-open');
        document.querySelectorAll('.afrozeh-custom-footer .afrozeh-footer-col').forEach(function(c) {
          c.classList.remove('is-open');
        });
        if (!isOpen) {
          col.classList.add('is-open');
        }
      }
    }
  });
</script>

{% schema %}
{
  "name": "Footer",
  "class": "hdt-section hdt-section--footer",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "group"
    },
    {
      "type": "_footer-column"
    }
  ],
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "footer"
    },
    {
      "type": "range",
      "id": "newsletter_heading_size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Newsletter Heading Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "col_heading_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Column Heading Size",
      "default": 14
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}