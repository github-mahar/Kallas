<!-- sections/explore-by-category.liquid -->
{{ 'explore-by-category.css' | asset_url | stylesheet_tag }}
{%- liquid
  # Section layout
  assign sizes = '(min-width: 1150px) ' | append: settings.page_width | append: 'px, (min-width: 750px) calc(100vw - 60px), calc(100vw - 30px)'

  case section.settings.section_layout 
    when 'container'
      assign parent = 'hdt-container'
      assign child  = 'hdt-section-spacing hdt-s-gradient hdt-relative hdt-section-spacing-' | append: section.id
    when 'wrapper_container'
      assign parent = 'hdt-section-spacing hdt-s-gradient hdt-relative hdt-section-spacing-' | append: section.id
      assign child  = 'hdt-container'
    when 'full_width'
      assign parent = 'hdt-container-full hdt-section-spacing hdt-s-gradient hdt-relative hdt-section-spacing-' | append: section.id
      assign child  = ''
      assign sizes  = '100vw'
  endcase

  assign space_item = section.settings.space_items | default: 20 | plus: 0
  assign max_h_dk = section.settings.max_height_dk | default: 420
  assign min_h_dk = section.settings.min_height_dk | default: 250
-%}

{%- style -%}
  {% render 'spacing-vars', box: section %}

  #{{ section.id }} .hdt-explore-categories-wrap {
    --space-items: {{ space_item }}px;
    --space-items-mb: {{ space_item | times: 0.65 | round }}px;
    {%- if section.settings.font_size == 'custom' -%}
      --title-font-size: {{ section.settings.font_size_text_lg | default: 18 }}px;
      --title-font-size-mb: {{ section.settings.font_size_text | default: 16 }}px;
    {%- endif -%}
  }

  @media (min-width: 768px) {
    #{{ section.id }} .hdt-explore-categories-list {
      gap: var(--space-items);
    }
    #{{ section.id }} .hdt-explore-category-item {
      flex: 1 1 0%;
      height: var(--item-height-dk, 350px);
    }
  }

  @media (max-width: 767px) {
    #{{ section.id }} .hdt-explore-categories-list {
      gap: var(--space-items-mb);
    }
    #{{ section.id }} .hdt-explore-category-item {
      height: var(--item-height-mb, 220px);
    }
  }
{%- endstyle -%}

<div id="{{ section.id }}" class="{{ parent }}{% if section.settings.heading_align_top %} has-heading-align-top{% endif %}" {%- if section.settings.colors_by_section %} color-scheme="{{ section.settings.color_scheme }}" style="--background-opacity: {{ section.settings.background_opacity }};"{%- endif %}>
  <div class="{{ child }}">

    {%- capture content_for_blocks -%}
      {% content_for 'blocks' %}
    {%- endcapture -%}

    <div class="hdt-explore-categories-wrap hdt-w-full">
      <div class="hdt-explore-heading-wrapper">
        {%- content_for 'block', type: 'section-heading', id: "section-heading-explore-category" -%}
      </div>
      <div class="hdt-explore-categories-list hdt-grid-cols-{{ section.settings.col_mb }} md:hdt-flex md:hdt-align-{{ section.settings.align_items | default: 'center' }} md:hdt-justify-center">
        
        {%- liquid
          if section.settings.collection_list != blank
            assign total_items = section.settings.collection_list.count
            for collection in section.settings.collection_list
              assign current_index = forloop.index
              
              if section.settings.height_mode == 'wave' and total_items > 1
                assign center_x2 = total_items | plus: 1
                assign curr_x2 = current_index | times: 2
                assign diff_x2 = curr_x2 | minus: center_x2 | abs
                assign max_diff_x2 = total_items | minus: 1
                assign h_diff = max_h_dk | minus: min_h_dk
                assign h_added = h_diff | times: diff_x2 | divided_by: max_diff_x2
                assign item_h_num = min_h_dk | plus: h_added | round
                assign item_h_dk = item_h_num | append: 'px'
              else
                assign item_h_dk = max_h_dk | append: 'px'
              endif

              assign image = collection.metafields.theme.featured_image_collection.value | default: collection.featured_image | default: collection.image | default: collection.products.first.featured_image
              assign title = collection.title | default: 'Collection'
              assign collection_link = collection.url
              
              render 'explore-category-card', collection: collection, image: image, title: title, collection_link: collection_link, item_h_dk: item_h_dk, item_h_mb: section.settings.height_mb, show_count: section.settings.show_count, count_label: section.settings.count_label, sizes: sizes
            endfor

          elsif section.blocks.size > 0
            echo content_for_blocks

          else
            # Placeholder items (5 items matching reference wave curve)
            assign total_items = 5
            for i in (1..5)
              assign current_index = i
              if section.settings.height_mode == 'wave' and total_items > 1
                assign center_x2 = total_items | plus: 1
                assign curr_x2 = current_index | times: 2
                assign diff_x2 = curr_x2 | minus: center_x2 | abs
                assign max_diff_x2 = total_items | minus: 1
                assign h_diff = max_h_dk | minus: min_h_dk
                assign h_added = h_diff | times: diff_x2 | divided_by: max_diff_x2
                assign item_h_num = min_h_dk | plus: h_added | round
                assign item_h_dk = item_h_num | append: 'px'
              else
                assign item_h_dk = max_h_dk | append: 'px'
              endif

              capture placeholder_svg
                cycle 'collection-apparel-1', 'collection-apparel-2', 'collection-apparel-3', 'collection-apparel-4'
              endcapture

              render 'explore-category-card', placeholder_svg: placeholder_svg, title: 'Category name', collection_link: '#', item_h_dk: item_h_dk, item_h_mb: section.settings.height_mb, show_count: false, sizes: sizes
            endfor
          endif
        -%}

      </div>
    </div>

  </div>
</div>

