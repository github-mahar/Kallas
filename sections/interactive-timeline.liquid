<!-- sections/interactive-timeline.liquid -->
{{ 'hdt-interactive-timeline.css' | asset_url | stylesheet_tag }}
{% style %}
  {% render 'spacing-vars', box: section %}
{% endstyle %}

{% liquid
  assign sizes = '(min-width: 1150px) ' | append: settings.page_width | append: 'px,(min-width: 750px) calc(100vw - 60px), calc(100vw - 30px)'

  case section.settings.section_layout
    when 'container'
      assign parent = 'hdt-container'
      assign child = 'hdt-section-spacing hdt-s-gradient hdt-relative hdt-section-spacing-' | append: section.id
    when 'wrapper_container'
      assign parent = 'hdt-section-spacing hdt-s-gradient hdt-relative hdt-section-spacing-' | append: section.id
      assign child = 'hdt-container'
    when 'full_width'
      assign parent = 'hdt-container-full hdt-section-spacing hdt-s-gradient hdt-relative hdt-section-spacing-' | append: section.id
      assign child = ''
      assign sizes = '100vw'
  endcase
  assign content_col = section.settings.col_content_dk | default: 5
  assign image_col = section.settings.col_img_dk | default: 7
%}

<div id="{{ section.id }}" class="{{ parent }}" {%- if section.settings.colors_by_section %} color-scheme="{{ section.settings.color_scheme }}" style="--background-opacity: {{ section.settings.background_opacity }};"{%- endif %}>
  <div class="{{ child }}">
    {%- if section.settings.section_background != blank -%}
      {% liquid
        assign bg_image = section.settings.section_background
      %}
      {{ bg_image | image_url: width: bg_image.width | image_tag: width: bg_image.width, height: bg_image.height, sizes: sizes, widths: '200,300,400,500,600,700,800,900,1000,1100,1200,1300,1400,1500,1600,1700,1800,1900,2000', loading: 'lazy', class: 'hdt-section-background hdt-absolute hdt-top-0 hdt-left-0 hdt-w-full hdt-h-full hdt-pe-none hdt-object-cover hdt-object-center' }}
    {%- endif -%}

    <hdt-interactive-timeline class="hdt-interactive-timeline-block hdt-block hdt-dots-style-{{ section.settings.dots_des | default: 'default' }}" style="--col-content: {{ content_col }}fr; --col-image: {{ image_col }}fr; --grid-gap: {{ settings.spacing_grid_horizontal | default: 30 }}px; --grid-gap-mb: {{ settings.spacing_grid_vertical | default: 30 }}px;">
      <div class="hdt-interactive-timeline-grid {% if section.settings.image_position == 'left' %}hdt-grid-reverse{% endif %}">
        
        <!-- Left Column: Section Header & Interactive Timeline List -->
        <div class="hdt-timeline-col-content">
          <div class="hdt-container-heading hdt-mb-6">
            {%- content_for "block", type: "section-heading", id: "interactive-timeline-heading" -%}
          </div>

          <!-- Timeline list rendered via Theme Blocks -->
          <div class="hdt-timeline-list hdt-relative">
            {% content_for "blocks" %}
          </div>
        </div>

        <!-- Right Column: Image Display -->
        <div class="hdt-timeline-col-images">
          <div class="hdt-timeline-images-wrapper hdt-relative hdt-oh hdt-ratio--{{ section.settings.image_ratio }}{% unless section.settings.image_size %} hdt-ratio--contain{% endunless %}" style="--img-radius: {{ settings.block_radius | default: 20 }}px;">
            {%- assign is_first = true -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'heading' or block.type == 'text' or block.type == 'spacer' or block.type == 'button' %}{% continue %}{% endif -%}
              <div 
                class="hdt-timeline-image-item {% if is_first %}is-active{% endif %}" 
                data-block-id="{{ block.id }}"
              >
                {%- if block.settings.image != blank -%}
                  <img 
                    src="{{ block.settings.image | image_url: width: 1400 }}" 
                    alt="{{ block.settings.image.alt | default: 'Timeline Image' | escape }}" 
                    loading="eager" 
                    width="{{ block.settings.image.width | default: 1400 }}" 
                    height="{{ block.settings.image.height | default: 900 }}" 
                    class="hdt-timeline-img hdt-w-full hdt-h-full hdt-object-cover"
                  >
                {%- else -%}
                  {%- assign placeholder_idx = forloop.index | modulo: 6 | plus: 1 -%}
                  {{ 'product-' | append: placeholder_idx | placeholder_svg_tag: 'hdt-timeline-placeholder-svg hdt-w-full hdt-h-full hdt-object-cover' }}
                {%- endif -%}
              </div>
              {%- assign is_first = false -%}
            {%- endfor -%}
          </div>
        </div>

      </div>
    </hdt-interactive-timeline>
  </div>
</div>

