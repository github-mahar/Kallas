<!-- sections/image-gallery.liquid -->

{%- liquid
  #Section layout

  case section.settings.section_layout 
    when 'container'
      assign parent = 'hdt-container'
      assign child  = 'hdt-section-spacing hdt-s-gradient hdt-relative' | append: ' hdt-section-spacing-' | append: section.id
    when 'wrapper_container'
      assign parent = 'hdt-section-spacing hdt-s-gradient hdt-relative' | append: ' hdt-section-spacing-' | append: section.id
      assign child  = 'hdt-container'
    when 'full_width'
      assign parent = 'hdt-container-full hdt-section-spacing hdt-s-gradient hdt-relative' | append: ' hdt-section-spacing-' | append: section.id
      assign child  = ''
      assign sizes  = '100vw'
  endcase
-%}
{%- capture content_block -%}
  {% content_for 'blocks' %}
{%- endcapture -%}
{% style %}
  {% render 'spacing-vars', box: section %}
  {%- if section.settings.space_items != 'x' -%}
    #shopify-section-{{section.id}} .hdt-spacing-{{ section.settings.space_items }} {
      --spacing-x: {{ section.settings.space_items }}px;
      --spacing-y: {{ section.settings.space_items }}px;
      @media (width < 767px){
        --spacing-x: {{ section.settings.space_items | divided_by: 2 }}px;
        --spacing-y: {{ section.settings.space_items | divided_by: 2 }}px;
      }
    }
  {%- endif -%}

  .hdt-container-image{
    --radius: {{ section.settings.border_radius | plus: 0.0 | divided_by: 16 }}rem;
    .hdt-image-wrap {
      border-radius: {{ section.settings.border_radius | plus: 0.0 | divided_by: 16 }}rem;
    }
  }
  {%- if section.settings.layout_mode == 'carousel' -%}
    #shopify-section-{{ section.id }} .hdt-slider__container > * {
      flex: 0 0 var(--slide-size);
      min-width: 0px;
      padding-inline-start: var(--slide-spacing);
    }
  {%- endif -%}
{% endstyle %}

<div id="section-{{ section.id }}" class="{{ parent }} {% if section.settings.hdt_background_parallax %} hdt-animate--parallax-bg {% endif %}" {%- if section.settings.colors_by_section %} color-scheme="{{ section.settings.color_scheme }}" style="--background-opacity: {{ section.settings.background_opacity }};"{%- endif %}>
  <div class="{{ child }}">
    {%- if section.settings.section_background != blank -%}
      {% liquid
        assign image = section.settings.section_background
      %}
      {{ image | image_url: width: image.width | image_tag: width: image.width, height: image.height, sizes: sizes, widths: '100,200,300,400,500,600,700,800,900,1000,1100,1200,1300,1400,1500,1600,1700,1800,1900,2000', loading: 'lazy', class: 'hdt-section-background hdt-absolute hdt-top-0 hdt-left-0 hdt-w-full hdt-h-full hdt-pe-none hdt-object-cover hdt-object-center' }}
    {%- endif -%}
    <hdt-gallery-modal id="{{ section.id }}" selector=".hdt-image-wrap img">
      <div class="hdt-container-heading">
        {%- content_for "block", type: "section-heading", id: "image-gallery-heading" -%}
      </div>      
      {%- if section.settings.layout_mode == 'carousel' -%}
        <hdt-slider id="Slider-{{ section.id }}" class="hdt-slider hdt-relative hdt-container-image hdt-row-grid--modify hdt-slide-spacing-{{ section.settings.space_items }} hdt-slider-center-{{ section.settings.hdt_slide_center }} lg:hdt-slides-{{ section.settings.col_dk }} md:hdt-slides-{{ section.settings.col_tb }} hdt-slides-{{ section.settings.col_mb }}" config='{ "id": "Slider-{{ section.id }}", "navUI": {{ section.settings.navUI }}, "dotUI": true, "loop": {{ section.settings.loop }}, "autoPlay": {{ section.settings.autoplay | times: 1000 }}, "pauseOnHover": {{ section.settings.pauseOnHover }}, "navUICenter": {{ section.settings.navUICenter }}{% if section.settings.hdt_slide_center %}, "containScroll": "trimSnaps", "align": "center"{% endif %} }'>
          <div class="hdt-slider__viewport hdt-relative">
            <div class="hdt-slider__container">
              {{ content_block }}
            </div>
          </div>
          {%- if section.settings.navUI -%}
            <div class="hdt-navigation hdt-position-{{ section.settings.nav_position }} hdt-visible-{{ section.settings.nav_visible }} hdt-style-{{ section.settings.nav_style }} hdt-shape-{{ section.settings.nav_shape }} hdt-size-{{ section.settings.nav_size }} hdt-hide-mobile-{{ section.settings.nav_hide_mobile }}">
              <button aria-controls="Slider-{{ section.id }}" class="hdt-slider__button hdt-slider__button--prev" type="button" disabled name="previous" aria-label="previous">
                <svg xmlns="http://www.w3.org/2000/svg" width="7" height="11" viewBox="0 0 7 11" fill="none"><path d="M5.5 11L0 5.5L5.5 0L6.47625 0.97625L1.9525 5.5L6.47625 10.0238L5.5 11Z" fill="currentColor"/></svg>
              </button>
              <button aria-controls="Slider-{{ section.id }}" class="hdt-slider__button hdt-slider__button--next" type="button" disabled name="next" aria-label="next">
                <svg xmlns="http://www.w3.org/2000/svg" width="7" height="11" viewBox="0 0 7 11" fill="none"><path d="M1.5 11L7 5.5L1.5 0L0.52375 0.97625L5.0475 5.5L0.52375 10.0238L1.5 11Z" fill="currentColor"/></svg>
              </button>
            </div>
          {%- endif -%}
          {%- if section.settings.dotUI -%}
            <div hdt-slider-dots aria-controls="Slider-{{ section.id }}" class="hdt-slider__dots hdt-pagination hdt-style-{{ section.settings.pag_style }} hdt-radius-{{ section.settings.pag_rounded }}{% if section.settings.only_show_mobile %} hdt-only-show-mobile{% else %} hdt-hide-mobile-{{ section.settings.pag_hide_mobile }}{% endif %}" style="--space-between: {{ section.settings.pag_space }}px; --margin-top: {{ section.settings.pag_mgt }}px;" hdt-reveal="slide-in" timeline></div>
          {%- endif -%}
        </hdt-slider>
      {%- else -%}
        <div class="hdt-row-grid hdt-container-image hdt-row-grid--modify hdt-spacing-{{ section.settings.space_items }} hdt-grid-cols-{{ section.settings.col_mb }} md:hdt-grid-cols-{{ section.settings.col_tb }} lg:hdt-grid-cols-{{ section.settings.col_dk }} hdt-justify-center">
          {{ content_block }}
        </div>
      {%- endif -%}
    </hdt-gallery-modal>
  </div>
</div>
