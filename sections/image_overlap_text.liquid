<!-- sections/image_overlap_text.liquid -->
{% style %}
  {% render 'spacing-vars', box: section %}

  #shopify-section-{{ section.id }} .hdt-overlap-images-wrap {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .hdt-overlap-img-primary {
    position: relative;
    width: {{ section.settings.primary_img_width }}%;
    z-index: 1;
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .hdt-overlap-img-secondary {
    position: absolute;
    right: {{ section.settings.secondary_right_offset }}%;
    top: 50%;
    transform: translateY(-50%);
    width: {{ section.settings.secondary_img_width }}%;
    z-index: 2;
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    {% if section.settings.enable_shadow %}
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
    {% endif %}
  }

  #shopify-section-{{ section.id }} .hdt-overlap-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-left: 3.5rem;
  }

  #shopify-section-{{ section.id }} .hdt-overlap-subheading {
    letter-spacing: 0.18em;
    font-size: 11px;
    text-transform: uppercase;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .hdt-overlap-heading {
    font-size: 28px;
    line-height: 1.25;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .hdt-overlap-body {
    font-size: 13.5px;
    line-height: 1.7;
    max-width: 520px;
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .hdt-overlap-content {
      padding-left: 0;
      margin-top: 2.5rem;
    }
    #shopify-section-{{ section.id }} .hdt-overlap-heading {
      font-size: 22px;
    }
    #shopify-section-{{ section.id }} .hdt-overlap-body {
      font-size: 13px;
    }
  }
{% endstyle %}

{% liquid
  case section.settings.section_layout 
    when 'container'
      assign parent = 'hdt-container'
      assign child  = 'hdt-section-spacing hdt-relative' | append: ' hdt-section-spacing-' | append: section.id
    when 'wrapper_container'
      assign parent = 'hdt-section-spacing hdt-relative' | append: ' hdt-section-spacing-' | append: section.id
      assign child  = 'hdt-container'
    when 'full_width'
      assign parent = 'hdt-container-full hdt-section-spacing hdt-relative' | append: ' hdt-section-spacing-' | append: section.id
      assign child  = ''
  endcase

  case section.settings.primary_aspect_ratio
    when 'portrait_4_5'
      assign primary_ratio = '125%'
    when 'portrait_3_4'
      assign primary_ratio = '133.33%'
    when 'square'
      assign primary_ratio = '100%'
    else
      assign primary_ratio = ''
  endcase

  case section.settings.secondary_aspect_ratio
    when 'portrait_4_5'
      assign secondary_ratio = '125%'
    when 'portrait_3_4'
      assign secondary_ratio = '135%'
    when 'square'
      assign secondary_ratio = '100%'
    else
      assign secondary_ratio = ''
  endcase
%}

<div id="{{ section.id }}" class="{{ parent }}" color-scheme="{{ section.settings.color_scheme }}">
  <div class="{{ child }}">
    <div class="hdt-row-grid hdt-grid-cols-1 md:hdt-grid-cols-2 hdt-align-center">
      
      <!-- Left Column: Overlapping Images -->
      <div class="hdt-overlap-images-col">
        <div class="hdt-overlap-images-wrap">
          <div class="hdt-overlap-img-primary">
            <div class="hdt-ratio hdt-oh" {% if section.settings.image_primary != blank and section.settings.primary_aspect_ratio == 'adapt' %}style="--aspect-ratioapt: {{ section.settings.image_primary.aspect_ratio }}"{% elsif primary_ratio != blank %}style="padding-bottom: {{ primary_ratio }};"{% endif %}>
              {%- if section.settings.image_primary != blank -%}
                {{ section.settings.image_primary | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'hdt-object-cover hdt-w-full hdt-h-full' }}
              {%- else -%}
                {{ 'product-apparel-1' | placeholder_svg_tag: 'hdt-placeholder-svg hdt-object-cover hdt-w-full hdt-h-full' }}
              {%- endif -%}
            </div>
          </div>
          <div class="hdt-overlap-img-secondary">
            <div class="hdt-ratio hdt-oh" {% if section.settings.image_secondary != blank and section.settings.secondary_aspect_ratio == 'adapt' %}style="--aspect-ratioapt: {{ section.settings.image_secondary.aspect_ratio }}"{% elsif secondary_ratio != blank %}style="padding-bottom: {{ secondary_ratio }};"{% endif %}>
              {%- if section.settings.image_secondary != blank -%}
                {{ section.settings.image_secondary | image_url: width: 800 | image_tag: loading: 'lazy', class: 'hdt-object-cover hdt-w-full hdt-h-full' }}
              {%- else -%}
                {{ 'product-apparel-2' | placeholder_svg_tag: 'hdt-placeholder-svg hdt-object-cover hdt-w-full hdt-h-full' }}
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Content -->
      <div class="hdt-overlap-content hdt-text-{{ section.settings.text_alignment }}">
        {%- if section.settings.subheading != blank -%}
          <span class="hdt-overlap-subheading hdt-block hdt-mb-3" style="color: {{ section.settings.subheading_color }};">
            {{ section.settings.subheading | escape }}
          </span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="hdt-overlap-heading hdt-mb-4" style="color: {{ section.settings.heading_color }};">
            {{ section.settings.heading | newline_to_br }}
          </h2>
        {%- endif -%}

        {%- if section.settings.body_text != blank -%}
          <div class="hdt-overlap-body hdt-rte hdt-mb-6" style="color: {{ section.settings.body_color }};">
            {{ section.settings.body_text }}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div>
            <a href="{{ section.settings.button_link | default: '#' }}" class="hdt-btn hdt-btn-custom hdt-btn-radius-full" style="background-color: #222; color: #fff; padding: 14px 40px; display: inline-flex; font-size: 13px; font-weight: 600; text-transform: uppercase;">
              <span>{{ section.settings.button_label }}</span>
            </a>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Overlapping images text",
  "tag": "section",
  "class": "hdt-section-overlap-images",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Images Settings"
    },
    {
      "type": "image_picker",
      "id": "image_primary",
      "label": "Primary Image (Left Main)",
      "info": "Recommended: 712 x 890 px (Aspect ratio 4:5) or 712 x 712 px (Aspect ratio 1:1)"
    },
    {
      "type": "select",
      "id": "primary_aspect_ratio",
      "label": "Primary image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait_4_5", "label": "Portrait (4:5)" },
        { "value": "portrait_3_4", "label": "Portrait (3:4)" },
        { "value": "square", "label": "Square (1:1)" }
      ],
      "default": "portrait_4_5"
    },
    {
      "type": "range",
      "id": "primary_img_width",
      "min": 40,
      "max": 80,
      "step": 1,
      "unit": "%",
      "label": "Primary image width",
      "default": 60
    },
    {
      "type": "image_picker",
      "id": "image_secondary",
      "label": "Secondary Image (Overlapping Right)",
      "info": "Recommended: 500 x 675 px (Aspect ratio 3:4) or 500 x 500 px (Aspect ratio 1:1)"
    },
    {
      "type": "select",
      "id": "secondary_aspect_ratio",
      "label": "Secondary image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait_3_4", "label": "Portrait (3:4)" },
        { "value": "portrait_4_5", "label": "Portrait (4:5)" },
        { "value": "square", "label": "Square (1:1)" }
      ],
      "default": "portrait_3_4"
    },
    {
      "type": "range",
      "id": "secondary_img_width",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "label": "Secondary image width",
      "default": 48
    },
    {
      "type": "range",
      "id": "secondary_right_offset",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "%",
      "label": "Secondary right offset",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "enable_shadow",
      "label": "Enable secondary image drop shadow",
      "default": true
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Image border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "ABOUT SAAD BIN SHAHZAD"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#666666"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "CRAFTING TRADITION.\nDEFINING STYLE"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>The journey of Saad Bin Shahzad is that of an Eclectic Wanderer – a soul navigating through a world of elegance and opulence. His work draws inspiration from ancient crafts, timeless artifacts, and majestic architecture, brought to life through meticulous handcrafting on rare and vintage textiles. Each creation is a tribute to heritage, reimagined with artistic flair and soulful expression.</p>"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text color",
      "default": "#444444"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "t:settings_schema.layout.name"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_layout",
      "label": "t:sections.all.section_layout.width.label",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "wrapper_container", "label": "Wrapper Container" },
        { "value": "full_width", "label": "Full width" }
      ],
      "default": "container"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_spacing"
    },
    {
      "type": "text",
      "id": "mg",
      "label": "Margin",
      "default": ",,50px,"
    },
    {
      "type": "text",
      "id": "mg_mb",
      "label": "Margin (Mobile)",
      "default": ",,30px,"
    },
    {
      "type": "text",
      "id": "pd",
      "label": "Padding",
      "default": "50px,,50px,"
    },
    {
      "type": "text",
      "id": "pd_mb",
      "label": "Padding (Mobile)",
      "default": "30px,,30px,"
    }
  ],
  "presets": [
    {
      "name": "Overlapping images text",
      "category": "02. Banner"
    }
  ]
}
{% endschema %}
