<div class="hdt-quote-wrap hdt-quote-10 hdt-ratio--{{ section.settings.image_ratio }} {% unless section.settings.image_size %} hdt-ratio--contain{% endunless %}">
  <div class="hdt-quote-media hdt-ratio" style="--aspect-ratioapt: {{ featured_media.aspect_ratio | default: 1 }}">
    {%- if block.settings.image_avata -%}
      {%- assign image = block.settings.image_avata -%} 
       {{ image | image_url: width: image.width | image_tag: loading: 'lazy', width: image.width, height: image.height, widths: '200,400,600,800,1000', class: 'hdt-quote-image' }}
      {%- endif -%}
  </div>
  <div class="hdt-quote-texts hdt-rte">
    <div class="hdt-quote-au-rev">
      {%- if block.settings.pos != blank -%}<div class="hdt-quote-position">{{ block.settings.pos }}</div>{%- endif -%} 
       {%- render 'rating_star', rating: block.settings.rating -%}
    </div>
    <div class="hdt-quote-content hdt-text-lg">
      {{ block.settings.content }}
    </div>
    <div class="hdt-quote-author">{{ block.settings.title }}</div>
  </div>
</div>