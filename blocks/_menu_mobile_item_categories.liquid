<!-- _menu_mobile_item_categories.liquid -->
{%- liquid
  assign li_class = ""
  if block.blocks.size > 0
    assign li_class = "hdt-has-children hdt-relative"
  endif
-%}
<li id="block-{{block.id}}" class="hdt-menu-item hdt-flex hdt-justify-center hdt-flex-col {{ li_class }}" style="--image-pd: {{block.settings.image_padding}}px; --content-space:{{block.settings.content_space}}px;" {{ block.shopify_attributes }}>
  {%- if block.settings.collection_list != blank -%}
    <hdt-accordion class="hdt-contents" only-click-icon>
      <details>
        <summary data-url="{{ block.settings.url }}" class="hdt-menu-link hdt-flex hdt-align-center hdt-justify-between hdt-relative hdt-text-base">
          <span class="hdt-menu-link-text hdt-block {%- if block.settings.lb != blank %} hdt-relative hdt-title_size-{{ block.settings.title | size | at_most: 20 }} hdt-has-1label{% endif %}">
            {% if block.settings.icon_image %}
            <i class="hdt-menu-link-icon hdt-mr-2 hdt-flex-shrink-0">
              {{
                block.settings.icon_image
                | image_url: width: 100, height: 100, crop: 'center'
                | image_tag: loading: 'lazy', sizes: 'auto', class: 'hdt-img_catk_mb'
              }}
            </i>
            {% endif %}
            <span class="hdt-block">
              {{ block.settings.title }}
              {%- if block.settings.lb != blank -%}
                <span class="hdt_label_menu hdt-inline-flex hdt-align-center hdt-justify-center hdt-text-xs">
                  <span class="hdt_label_{{ block.settings.lb | handleize }} hdt-flex hdt-align-center hdt-justify-center">{{ block.settings.lb }}</span>
                </span>
              {%- endif -%}
            </span>
          </span>
          <span class="hdt-btn-open-sub hdt-relative" accordion-icon></span>
        </summary>
        <div class="hdt-mb-sub-menu hdt-menu-list hdt-mb-sub-menu-lever-1 hdt-collections-list hdt-has-collection{{ block.settings.collection_des }} hdt-colelction-border-{{ block.settings.enable_border }} hdt-image-rounded-{{ block.settings.image_rounded }} hdt-ratio--{{ block.settings.image_ratio }} {% unless block.settings.image_size %} hdt-ratio--contain{% endunless %}" color-scheme="{{ block.settings.collection_list_colors }}">
          {% for collection in block.settings.collection_list %}
            {% content_for 'block', type: '_menu_mobile_categories_item', id: 'menu_mobile_categories_item', closest.collection: collection, collection_des: block.settings.collection_des, show_count: block.settings.show_count, count_label: block.settings.count_label, content_position: block.settings.content_position, content_size: block.settings.content_size, content_weight: block.settings.content_weight %}
          {% endfor %}
        </div>
      </details>
    </hdt-accordion>
  {%- else -%}
    <a href="{{ block.settings.url }}" class="hdt-menu-link hdt-flex hdt-align-center hdt-justify-between hdt-relative hdt-text-base">
      <span class="hdt-menu-link-text hdt-block {%- if block.settings.lb != blank %} hdt-relative hdt-title_size-{{ block.settings.title | size | at_most: 20 }} hdt-has-1label{% endif %}">
        {% if block.settings.icon_image %}
        <i class="hdt-menu-link-icon hdt-mr-2 hdt-flex-shrink-0">
          {{
            block.settings.icon_image
            | image_url: width: 100, height: 100, crop: 'center'
            | image_tag: loading: 'lazy', sizes: 'auto', class: 'hdt-img_catk_mb'
          }}
        </i>
        {% endif %}
        <span class="hdt-block">
          {{ block.settings.title }}
          {%- if block.settings.lb != blank -%}
            <span class="hdt_label_menu hdt-inline-flex hdt-align-center hdt-justify-center hdt-text-xs">
              <span class="hdt_label_{{ block.settings.lb | handleize }} hdt-flex hdt-align-center hdt-justify-center">{{ block.settings.lb }}</span>
            </span>
          {%- endif -%}
        </span>
      </span>
    </a>
  {%- endif -%}
</li>
{% schema %}
{
  "name": "Collection Image List",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:settings_schema.heading.name",
      "default": "Collection title"
    },
    {
      "type": "url",
      "id": "url",
