    },
    {
      "type": "checkbox",
      "id": "image_rounded",
      "label": "t:sections.collections-list.settings.image_rounded.label",
      "default": false,
      "visible_if": "{{ block.settings.collection_list }}"
    },
    {
      "type": "checkbox",
      "id": "enable_border",
