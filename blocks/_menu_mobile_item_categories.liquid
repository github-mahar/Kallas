      "default": "adapt_image",
      "visible_if": "{{ block.settings.collection_list }}"
    },
    {
      "type": "checkbox",
      "id": "image_size",
      "label": "t:sections.all.images.size.cover",
      "default": true,
      "visible_if": "{{ block.settings.collection_list }}"
    }
  ],
  "presets": [
    {
      "name": "Collection Image List",
      "settings": {},
      "blocks": [
        {
          "type": "_menu_mobile_categories_item",
          "id": "menu_mobile_categories_item",
          "static": true
        }
      ]
    }
  ]
}
{% endschema %}