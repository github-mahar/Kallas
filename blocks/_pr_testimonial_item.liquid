{% stylesheet %}
  .hdt-pr-tes__item{
    .hdt-inner{
      background-color: rgb(var(--color-background2, var(--color-base-background)));
      padding: clamp(1rem, 3vw,2.4rem);
      gap: clamp(1rem, 3vw, 3.2rem);
    }
    .hdt-tes-auth{
      font-size: 1.5rem;
      gap: 0.7rem;
      svg{
        width: 1.5rem;
        height: 1.5rem;
        flex: 0 0 auto;
      }
    }
    .hdt-tes-top{
      row-gap: 0.5rem;
      column-gap: 1.5rem;
      margin-bottom: clamp(1rem, 2vw, 1.5rem);
      flex-wrap: wrap;
    }
    .hdt-tes-media{
      width: 8.4rem;
      height: 8.4rem;
      flex: 0 0 auto;
    }
  }
{% endstylesheet %}
{%-liquid
  assign image = block.settings.image
  assign title = block.settings.title
  assign content = block.settings.content
  assign rating = block.settings.rating | default: 4.5
  assign rating_number = rating | plus: 0
-%}
{%- capture stars_html -%}
  <div class="hdt-social-proof__stars-wrap">
    <div class="hdt-social-proof__stars">
      {%- for i in (1..5) -%}
        {%- assign difference = rating_number | minus: i -%}
        {%- if difference >= 0 -%}
          <svg viewBox="0 0 23 22" class="hdt-social-proof__star hdt-social-proof__star--full" aria-hidden="true" focusable="false">
            <path d="M11.4127 0L14.1069 8.2918H22.8254L15.772 13.4164L18.4661 21.7082L11.4127 16.5836L4.3593 21.7082L7.05346 13.4164L4.19617e-05 8.2918H8.71855L11.4127 0Z" fill="currentColor" />
          </svg>
        {%- elsif difference > -1 and difference < 0 -%}
          <svg viewBox="0 0 23 22" class="hdt-social-proof__star hdt-social-proof__star--half" aria-hidden="true" focusable="false">
            <path d="M13.7506 8.40723L13.8346 8.66699H21.6705L15.5514 13.1133L15.3307 13.2734L15.4156 13.5322L17.7526 20.7266L11.6334 16.2803L11.4127 16.1201L11.192 16.2803L5.0719 20.7266L7.40979 13.5322L7.49475 13.2734L7.27405 13.1133L1.15491 8.66699H8.99084L9.07483 8.40723L11.4127 1.21289L13.7506 8.40723Z" fill="url(#paint0_linear_7170_5040_{{ block.id }}_{{ i }})" stroke="currentColor" stroke-width="0.75"/>
            <defs>
              <linearGradient id="paint0_linear_7170_5040_{{ block.id }}_{{ i }}" x1="-0.58728" y1="12" x2="23.4127" y2="12" gradientUnits="userSpaceOnUse">
                <stop stop-color="currentColor"/>
                <stop offset="0.5" stop-color="currentColor"/>
                <stop offset="0.51" stop-color="currentColor" stop-opacity="0"/>
                <stop offset="1" stop-color="currentColor" stop-opacity="0"/>
              </linearGradient>
            </defs>
          </svg>
        {%- else -%}
          <svg viewBox="0 0 23 22" class="hdt-social-proof__star hdt-social-proof__star--empty" aria-hidden="true" focusable="false">
            <path d="M13.7506 8.40723L13.8346 8.66699H21.6705L15.5514 13.1133L15.3307 13.2734L15.4156 13.5322L17.7526 20.7266L11.6334 16.2803L11.4127 16.1201L11.192 16.2803L5.0719 20.7266L7.40979 13.5322L7.49475 13.2734L7.27405 13.1133L1.15491 8.66699H8.99084L9.07483 8.40723L11.4127 1.21289L13.7506 8.40723Z" fill="none" stroke="currentColor" stroke-width="0.75"/>
          </svg>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endcapture -%}
<div class="hdt-pr-tes__item hdt-slider__slide">
  <div class="hdt-inner hdt-radius hdt-oh hdt-flex hdt-align-center">
    <div class="hdt-tes-media hdt-radius-full hdt-oh">
      {%- if image != blank -%}
        {{ image | image_url: width: image.weight, height: image.height | image_tag: width: image.weight, height: image.height, loading: 'lazy', widths: '100,200,300,400,500', sizes:'auto', class: 'hdt-pr-tes-media hdt-w-full hdt-h-full hdt-object-fit hdt-object-cover' }}
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg hdt-placeholder hdt-w-full hdt-h-full' }}
      {%- endif -%}
    </div>
    <div class="hdt-tes-ct hdt-s-text">
      <div class="hdt-tes-top hdt-flex hdt-align-center">
        <div class="hdt-tes-auth hdt-font-semibold hdt-flex hdt-align-center">
          {{ title }} 
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M13.4121 5.21042V3.34209C13.4121 2.92216 13.2453 2.51943 12.9483 2.2225C12.6514 1.92557 12.2487 1.75875 11.8288 1.75875H10L8.70167 0.460422C8.40501 0.165524 8.00371 0 7.58542 0C7.16713 0 6.76583 0.165524 6.46917 0.460422L5.21042 1.75875H3.34209C2.92216 1.75875 2.51943 1.92557 2.2225 2.2225C1.92557 2.51943 1.75875 2.92216 1.75875 3.34209V5.21042L0.460422 6.46917C0.165524 6.76583 0 7.16713 0 7.58542C0 8.00371 0.165524 8.40501 0.460422 8.70167L1.75875 10V11.8288C1.75875 12.2487 1.92557 12.6514 2.2225 12.9483C2.51943 13.2453 2.92216 13.4121 3.34209 13.4121H5.21042L6.46917 14.7104C6.76583 15.0053 7.16713 15.1708 7.58542 15.1708C8.00371 15.1708 8.40501 15.0053 8.70167 14.7104L10 13.4121H11.8288C12.2487 13.4121 12.6514 13.2453 12.9483 12.9483C13.2453 12.6514 13.4121 12.2487 13.4121 11.8288V10L14.7104 8.70167C15.0053 8.40501 15.1708 8.00371 15.1708 7.58542C15.1708 7.16713 15.0053 6.76583 14.7104 6.46917L13.4121 5.21042Z" fill="#47BF73"/>
            <path d="M6.99161 9.56435C6.88742 9.56495 6.78414 9.54498 6.68769 9.50559C6.59123 9.46619 6.5035 9.40814 6.42953 9.33477L5.21036 8.14727C5.06129 7.99819 4.97754 7.79601 4.97754 7.58518C4.97754 7.37436 5.06129 7.17217 5.21036 7.0231C5.35944 6.87403 5.56162 6.79028 5.77244 6.79028C5.98327 6.79028 6.18545 6.87403 6.33453 7.0231L6.95994 7.65643L8.77286 5.8356C8.92194 5.67813 9.12746 5.58632 9.34422 5.58039C9.56098 5.57445 9.77122 5.65486 9.9287 5.80393C10.0862 5.95301 10.178 6.15853 10.1839 6.37529C10.1898 6.59205 10.1094 6.80229 9.96036 6.95977L7.58536 9.33477C7.50767 9.41204 7.41478 9.47235 7.31258 9.51187C7.21038 9.55139 7.10108 9.56926 6.99161 9.56435Z" fill="white"/>
          </svg>  
        </div>  
        <div class="hdt-tes-rating">
          {{ stars_html }}  
        </div>      
      </div>
      <div class="hdt-tes-content">
        {{ content }}
      </div>
    </div>
  </div>
</div>
{% schema %}
  {
    "name": "Item",
    "tag": null,
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Author",
        "default": "MarkCow. J"
      },
      {
        "type": "richtext",
        "id": "content",
        "label": "Content",
        "default": "<p>\"I sent this directly to my girlfriend and she absulutely loved it. Beautiful quality and arrived right on time.\"</p>"
      },
      {
        "type": "header",
        "content": "Rating"
      },
      {
        "type": "range",
        "id": "rating",
        "min": 1,
        "max": 5,
        "step": 0.5,
        "label": "Rating Score",
        "default": 4.5
      },
    ],
    "presets": [
      {
        "name": "Item"
      }
    ]
  }
{% endschema %}
