    },
    {
      "type": "text",
      "id": "custom_aspect_ratio",
      "label": "Custom Aspect Ratio (width / height)",
      "info": "Must be > 0. Example: 0.72 for tall item, 1.48 for half-stacked item. Leave blank or 0 to use image ratio.",
      "visible_if": "{{ block.settings.enable_custom_ratio == true and block.settings.height_dk == 0 and block.settings.height_tb == 0 and block.settings.height_mb == 0}}"
    },
    {
      "type": "range",
      "id": "height_dk",
      "label": "Custom Height Desktop (px)",
      "info": "Set > 0 to force item height. Example: 550px for tall item, 265px for stacked item.",
      "min": 0,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.enable_custom_ratio == true and block.settings.custom_aspect_ratio == blank}}"
    },
    {
      "type": "range",
      "id": "height_tb",
