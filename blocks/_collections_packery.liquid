{%- style -%}
  {%- if block.settings.image_ratio == 'custom_height' -%}
    #{{ block.id }} .hdt-ratio--custom_height .hdt-ratio {
      --ratio-percent: calc(100% / (var(--aspect-ratioapt, 1.2)));
    }
    {%- if block.settings.height_mb > 0 -%}
      @media(max-width:767px){
        #{{ block.id }} .hdt-collection-img:not(.hdt-has-custom-ratio-height) {
          height: {{ block.settings.height_mb }}px;
        }
        #{{ block.id }} .hdt-collection-img:not(.hdt-has-custom-ratio-height) .hdt-ratio {
          height: 100%;
        }
        #{{ block.id }} .hdt-collection-img:not(.hdt-has-custom-ratio-height) .hdt-ratio::before {
          display: none !important;
        }
        #{{ block.id }} .hdt-collection-img:not(.hdt-has-custom-ratio-height) .hdt-ratio img {
          position: absolute;
          top: 0;
          left: 0;
          width: 100% !important;
          height: 100% !important;
          object-fit: cover;
        }
      }
    {%- endif -%}
    {%- if block.settings.height_tb > 0 -%}
      @media(min-width:768px) and (max-width:1149px){
        #{{ block.id }} .hdt-collection-img:not(.hdt-has-custom-ratio-height) {
          height: {{ block.settings.height_tb }}px;
        }
        #{{ block.id }} .hdt-collection-img:not(.hdt-has-custom-ratio-height) .hdt-ratio {
          height: 100%;
        }
        #{{ block.id }} .hdt-collection-img:not(.hdt-has-custom-ratio-height) .hdt-ratio::before {
          display: none !important;
        }
        #{{ block.id }} .hdt-collection-img:not(.hdt-has-custom-ratio-height) .hdt-ratio img {
          position: absolute;
          top: 0;
          left: 0;
          width: 100% !important;
          height: 100% !important;
          object-fit: cover;
        }
      }
    {%- endif -%}
    {%- if block.settings.height_dk > 0 -%}
      @media(min-width:1150px){
        #{{ block.id }} .hdt-collection-img:not(.hdt-has-custom-ratio-height) {
          height: {{ block.settings.height_dk }}px;
        }
        #{{ block.id }} .hdt-collection-img:not(.hdt-has-custom-ratio-height) .hdt-ratio {
          height: 100%;
        }
        #{{ block.id }} .hdt-collection-img:not(.hdt-has-custom-ratio-height) .hdt-ratio::before {
          display: none !important;
        }
        #{{ block.id }} .hdt-collection-img:not(.hdt-has-custom-ratio-height) .hdt-ratio img {
          position: absolute;
          top: 0;
          left: 0;
          width: 100% !important;
          height: 100% !important;
          object-fit: cover;
        }
      }
    {%- endif -%}
  {%- endif -%}

  @media(max-width:767px){
    #{{ block.id }} .hdt-has-custom-height[style*="--item-height-mb"] {
      height: var(--item-height-mb) !important;
    }
    #{{ block.id }} .hdt-has-custom-height[style*="--item-height-mb"] .hdt-ratio {
      height: 100%;
    }
    #{{ block.id }} .hdt-has-custom-height[style*="--item-height-mb"] .hdt-ratio::before {
      display: none !important;
    }
    #{{ block.id }} .hdt-has-custom-height[style*="--item-height-mb"] .hdt-ratio img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100% !important;
      height: 100% !important;
      object-fit: cover;
    }
  }

  @media(min-width:768px) and (max-width:1149px){
    #{{ block.id }} .hdt-has-custom-height[style*="--item-height-tb"] {
      height: var(--item-height-tb) !important;
    }
    #{{ block.id }} .hdt-has-custom-height[style*="--item-height-tb"] .hdt-ratio {
      height: 100%;
    }
    #{{ block.id }} .hdt-has-custom-height[style*="--item-height-tb"] .hdt-ratio::before {
      display: none !important;
    }
    #{{ block.id }} .hdt-has-custom-height[style*="--item-height-tb"] .hdt-ratio img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100% !important;
      height: 100% !important;
      object-fit: cover;
    }
  }

  @media(min-width:1150px){
    #{{ block.id }} .hdt-has-custom-height[style*="--item-height-dk"] {
      height: var(--item-height-dk) !important;
    }
    #{{ block.id }} .hdt-has-custom-height[style*="--item-height-dk"] .hdt-ratio {
      height: 100%;
    }
    #{{ block.id }} .hdt-has-custom-height[style*="--item-height-dk"] .hdt-ratio::before {
      display: none !important;
    }
    #{{ block.id }} .hdt-has-custom-height[style*="--item-height-dk"] .hdt-ratio img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100% !important;
      height: 100% !important;
      object-fit: cover;
    }
  }
  #{{ block.id }} .hdt-collections-list {
    --gutter: {{ block.settings.gap_item_mb }}px;
    margin-bottom: calc(var(--gutter) * -1) !important;
  }
  @media(min-width:768px){
    #{{ block.id }} .hdt-collections-list {
      --gutter: {{ block.settings.gap_item_tb }}px;
      margin-bottom: calc(var(--gutter) * -1) !important;
    }
  }
  @media(min-width:1150px){
    #{{ block.id }} .hdt-collections-list {
      --gutter: {{ block.settings.gap_item_dk }}px;
      margin-bottom: calc(var(--gutter) * -1) !important;
    }
  }
  .hdt-column_inner:has(#{{ block.id }}) {
    place-self: stretch !important;
    width: 100% !important;
  }
  #{{ block.id }} .hdt-collection-inner,
  #{{ block.id }} .hdt-collection-img,
  #{{ block.id }} .hdt-ratio,
  #{{ block.id }} img,
  #{{ block.id }} svg,
  #{{ block.id }} .hdt-eff-border-run::before,
  #{{ block.id }} .hdt-eff-border-run::after {
    {%- if block.settings.image_radius != blank -%}
      {%- case block.settings.image_radius -%}
        {%- when 'hdt-btn-radius-none' -%}
          border-radius: 0;
        {%- when 'hdt-btn-radius-xs' -%}
          border-radius: max(var(--radius-xs), 2px);
        {%- when 'hdt-btn-radius-sm' -%}
          border-radius: max(var(--radius-sm), 3px);
        {%- when 'hdt-btn-radius' -%}
          border-radius: max(var(--radius), 5px);
        {%- when 'hdt-btn-radius-lg' -%}
          border-radius: max(var(--radius-lg), 8px);
        {%- when 'hdt-btn-radius-full' -%}
          border-radius: var(--radius-full);
      {%- endcase -%}
    {%- else -%}
      border-radius: var(--radius-collection-card);
    {%- endif -%}
    overflow: hidden;
  }
{%- endstyle -%}
{{ 'hdt-collection-items.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign collection_des = 1
  assign content_size = 'base'
  assign content_weight = block.settings.content_weight
  assign content_position = block.settings.content_position
  assign show_count = false
  assign count_label = 'Products'
  assign b_effect = block.settings.b_effect
  assign img_effect = block.settings.img_effect
  assign gap_item_dk = block.settings.gap_item_dk
  assign gap_item_tb = block.settings.gap_item_tb
  assign gap_item_mb = block.settings.gap_item_mb
  assign layout_mode = 'packery'
-%}
{%- if false -%}
  {{ collection_des }}{{ content_size }}{{ content_weight }}{{ content_position }}{{ show_count }}{{ count_label }}{{ b_effect }}{{ img_effect }}{{ gap_item_dk }}{{ gap_item_tb }}{{ gap_item_mb }}{{ layout_mode }}
{%- endif -%}

<div id="{{ block.id }}" class="hdt-collections-packery-wrap" {{ block.shopify_attributes }}>
  <packery-layout class="hdt-block hdt-oh hdt-packery-layout" layout="[data-layout]" selector="[item-selector]">
    <div class="hdt-collections-list hdt-has-collection1 hdt-colelction-border-false hdt-image-rounded-false hdt-ratio--{{ block.settings.image_ratio }} {% unless block.settings.image_size %} hdt-ratio--contain{% endunless %} hdt-relative hdt-gutter-{{ block.settings.gap_item_mb }} md:hdt-gutter-{{ block.settings.gap_item_tb }} lg:hdt-gutter-{{ block.settings.gap_item_dk }}" data-img-effect="{{ block.settings.img_effect }}" data-b-effect="{{ block.settings.b_effect }}" data-layout>
      {% content_for 'blocks' %}
    </div>
  </packery-layout>
</div>
<script src="{{ 'packery.js' | asset_url }}" defer></script>
<script>
  (function() {
    function applyEffects() {
      const wrap = document.getElementById("{{ block.id }}");
      if (!wrap) return;
      const list = wrap.querySelector(".hdt-collections-list");
      if (!list) return;
      const imgEff = list.getAttribute("data-img-effect");
      const bEff = list.getAttribute("data-b-effect");
      list.querySelectorAll(".hdt-collection-img").forEach(function(img) {
        // Clear any old effect classes
        img.className.split(' ').forEach(function(className) {
          if (className.startsWith('hdt-eff-')) {
            img.classList.remove(className);
          }
        });
        // Add new classes
        if (imgEff && imgEff !== "none") {
          img.classList.add("hdt-eff-img-" + imgEff);
        }
        if (bEff && bEff !== "none") {
          img.classList.add("hdt-eff-" + bEff);
        }
      });
    }
    applyEffects();
    document.addEventListener("DOMContentLoaded", applyEffects);
    document.addEventListener("shopify:section:load", applyEffects);
  })();
</script>

{% schema %}
{
  "name": "Collections Packery",
  "class": "hdt-collections-packery",
  "blocks": [
    {
      "type": "_collections_packery_item"
    },
    {
