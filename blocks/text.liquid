{% liquid
  assign effect = 'hdt-reveal="slide-in" timeline'
  if section.id contains 'slideshow'
    assign effect = 'reval'
  endif   
  if section.location contains 'footer' or section.location == 'header'
    assign effect = ''
  endif
%}

{%- capture css -%}
  {%- if block.settings.text_color == 'hdt-text-custom-color' -%}
    --text-custom-color: {{ block.settings.text_custom_color }};
  {%- endif -%}
  {%- if block.settings.ffamily != '' -%}
    --ff:var({{ block.settings.ffamily }});
  {%- endif -%}
  {%- if block.settings.text_size == "custom" -%}
    --text-custom-lg: {{ block.settings.font_size_text_lg }}px; --text-custom-mb: {{ block.settings.font_size_text }}px; --text-ls: {{ block.settings.letter_spacing_text }}px;
  {%- endif -%}
{%- endcapture -%}

<div {{ effect }} id="block-{{ block.id }}" class="hdt-block-text {%- if block.settings.text_color == 'hdt-text-custom-color' %} hdt-text-custom-color{% endif %} hdt-rte {{ block.settings.text_color }}{% if block.settings.hidden_br_mobile %} hdt-br-hidden{% endif %}{% if block.settings.hidden_on_mobile %} hdt-hide-mobile{% endif %} hdt-text-{{ block.settings.text_size }} hdt-font-{{ block.settings.font_weight }} {{ block.settings.line_height }}" {{ block.shopify_attributes }} {%- if css != blank %} style="{{ css }}"{% endif %}>
  {{ block.settings.text }}
</div>
{% schema %}
{
  "name": "t:blocks.text.name",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "t:content",
      "default": "<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.</p>",
      "info": "t:blocks.text.settings.content.info"
    },
    {
      "type": "checkbox",
      "id": "hidden_br_mobile",
      "label": "t:blocks.text.settings.hidden_br_mobile",
      "default": false,
      "visible_if": "{{ block.settings.text contains '<br/>' }}"
    },
    {
      "type": "checkbox",
      "id": "hidden_on_mobile",
      "label": "t:blocks.text.settings.hidden_on_mobile",
      "default": false,
      "visible_if": "{{ block.settings.text != blank }}"
    },
    {
      "type": "select",
      "id": "ffamily",
      "options": [
        {
          "value": "",
          "label": "Default"
        },
        {
          "value": "--f_family_1",
          "label": "Font Family #1"
        },
        {
          "value": "--f_family_2",
          "label": "Font Family #2"
        },
        {
          "value": "--f_family_3",
          "label": "Font Family #3"
        },
        {
          "value": "--f_family_4",
          "label": "Font Family #4 (Custom)"
        },
        {
          "value": "--f_family_5",
          "label": "Font Family #5 (Custom)"
        }
      ],
      "label": "t:blocks.text_custom.settings.font_family.label",
      "default": ""
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "t:settings_schema.typography.settings.font_size.label",
      "options": [
        {
          "value": "--",
          "label": "Default"
        },
        {
          "value": "xs",
          "label": "Extra Small"
        },
        {
          "value": "sm",
          "label": "Small"
        },
        {
          "value": "base",
          "label": "Medium"
        },
        {
          "value": "lg",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "Extra Large"
        },
        {
          "value": "2xl",
          "label": "2 Extra Large"
        },
        {
          "value": "4xl",
          "label": "4 Extra Large"
        },
        {
          "value": "custom",
          "label": "Custom size inline"
        }
      ],
      "default": "--"
    },
    {
      "type": "select",
      "id": "line_height",
      "label": "t:settings_schema.typography.settings.line_height.label",
      "options": [
        {
          "value": "",
          "label": "Default"
        },
        {
          "value": "hdt-lh-1-2",
          "label": "Small"
        },
        {
          "value": "hdt-lh-1",
          "label": "Fit"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "t:settings_schema.typography.settings.font_weight.label",
      "options": [
        {
          "value": "light",
          "label": "t:settings_schema.typography.settings.font_weight.light"
        },
        {
          "value": "normal",
          "label": "t:settings_schema.typography.settings.font_weight.normal"
        },
        {
          "value": "medium",
          "label": "t:settings_schema.typography.settings.font_weight.medium"
        },
        {
          "value": "semibold",
          "label": "t:settings_schema.typography.settings.font_weight.semibold"
        },
        {
          "value": "bold",
          "label": "t:settings_schema.typography.settings.font_weight.bold"
        }
      ],
      "default": "normal"
    },
    {
      "type": "select",
      "id": "text_color",
      "options": [
        {
          "value": "hdt-s-text",
          "label": "Default"
        },
        {
          "value": "hdt-text-secondary",
          "label": "Secondary"
        },
        {
          "value": "hdt-text-tertiary",
          "label": "Tertiary"
        },
        {
          "value": "hdt-text-primary",
          "label": "Accent"
        },
        {
          "value": "hdt-text-custom-color",
          "label": "Custom color"
        }
      ],
      "label": "t:sections.countdown-bar.blocks.countdown.settings.text_color.label",
      "default": "hdt-s-text"
    },
    {
      "type": "color",
      "id": "text_custom_color",
      "label": "Custom color",
      "default": "#000",
      "alpha": true,
      "visible_if": "{{ block.settings.text_color == 'hdt-text-custom-color' }}"
    },
    {
      "type": "header",
      "content": "Custom size options",
      "visible_if": "{{ block.settings.text_size == 'custom' }}"
    },
    {
      "type": "range",
      "id": "font_size_text_lg",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings_schema.typography.settings.font_size.label",
      "default": 16,
      "visible_if": "{{ block.settings.text_size == 'custom' }}"
    },
    {
      "type": "range",
      "id": "font_size_text",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "t:settings_schema.typography.settings.font_size.mobile_font_size",
      "default": 14,
      "visible_if": "{{ block.settings.text_size == 'custom' }}"
    },
    {
      "type": "range",
      "id": "letter_spacing_text",
      "min": -10,
      "max": 10,
      "step": 0.2,
      "unit": "px",
      "label": "t:settings_schema.typography.settings.letter_spacing",
      "default": 0,
      "visible_if": "{{ block.settings.text_size == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "Text"
    }
  ]
}
{% endschema %}
