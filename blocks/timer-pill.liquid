{% stylesheet %}
.hdt-timer-pill .hdt-countdown {
  padding: 5px 25px;
  border-radius: 50px;
  background: #FFEBE5;
  color: #EA6059;
  font-size: 20px;
  font-weight: 500;
  @media (min-width: 767px){
    padding: 11px 40px;
  }
}
.hdt-timer-pill .hdt-countdown__inner {
  min-width: 115px;
}
.hdt-timer-pill-icon {
  padding-inline-end: 10px;
}
{% endstylesheet %}
<hdt-countdown class="hdt-countdown hdt-inline-block" config='{"month":"{{ block.settings.month }}", "date":"{{ block.settings.day }}, {{ block.settings.year }} {{ block.settings.hour }}:{{ block.settings.minute }}", "hideTimerOnComplete": {{ block.settings.hide_on_complete }}, "hasZero": {{ block.settings.prepend_number }}, "hasTextPlural": true }' hdt-reveal="slide-in" timeline>
  <div class="hdt-flex hdt-align-center hdt-justify-center">
    <div class="hdt-timer-pill-icon">
      {{ 'clock.svg' | inline_asset_content }}
    </div>
    <div class="hdt-countdown__inner hdt-flex hdt-align-center" aria-hidden="true">
      <hdt-countdown-amount effect="{{ effect_cd }}" class="hdt-countdown__amount hdt-inline-flex" data-days>00</hdt-countdown-amount>
      <span>:</span>
      <hdt-countdown-amount effect="{{ effect_cd }}" class="hdt-countdown__amount hdt-inline-flex" data-hours>00</hdt-countdown-amount>
      <span>:</span>
      <hdt-countdown-amount effect="{{ effect_cd }}" class="hdt-countdown__amount hdt-inline-flex" data-minutes>00</hdt-countdown-amount>
      <span>:</span>
      <hdt-countdown-amount effect="{{ effect_cd }}" class="hdt-countdown__amount hdt-inline-flex" data-seconds>00</hdt-countdown-amount>
    </div>
  </div>
</hdt-countdown>
{% schema %}
{
  "name": "Timer Pill",
  "class": "hdt-timer-pill",
  "settings": [
    {
      "type": "number",
      "id": "year",
      "default": 2030,
      "label": "t:sections.countdown-bar.blocks.countdown.settings.year.label",
      "info": "t:sections.countdown-bar.blocks.countdown.settings.year.info"
    },
    {
      "type": "range",
      "id": "month",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "t:sections.countdown-bar.blocks.countdown.settings.month.label"
    },
    {
      "type": "range",
      "id": "day",
      "min": 1,
      "max": 31,
      "step": 1,
      "default": 19,
      "label": "t:sections.countdown-bar.blocks.countdown.settings.day.label"
    },
    {
      "type": "range",
      "id": "hour",
      "min": 0,
      "max": 23,
      "step": 1,
      "default": 12,
      "label": "t:sections.countdown-bar.blocks.countdown.settings.hour.label"
    },
    {
      "type": "range",
      "id": "minute",
      "min": 0,
      "max": 59,
      "step": 1,
      "default": 0,
      "label": "t:sections.countdown-bar.blocks.countdown.settings.minute.label"
    },
    {
      "type": "select",
      "id": "effect_cd",
      "label": "t:sections.countdown-bar.blocks.countdown.settings.animate_num.label",
      "options": [
        {
          "value": "none",
          "label": "t:none"
        },
        {
          "value": "move_top",
          "label": "t:sections.countdown-bar.blocks.countdown.settings.animate_num.options__2.label"
        },
        {
          "value": "move_bottom",
          "label": "t:sections.countdown-bar.blocks.countdown.settings.animate_num.options__3.label"
        },
        {
          "value": "scale",
          "label": "t:sections.countdown-bar.blocks.countdown.settings.animate_num.options__4.label"
        },
        {
          "value": "rotate",
          "label": "t:sections.countdown-bar.blocks.countdown.settings.animate_num.options__5.label"
        }
      ],
      "default": "move_top"
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "t:settings_schema.typography.settings.uppercase",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "prepend_number",
      "label": "t:sections.countdown-bar.blocks.countdown.settings.prepend_number.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_complete",
      "default": false,
      "label": "t:sections.countdown-bar.blocks.countdown.settings.hide_on_complete.label"
    }
  ],
  "presets": [
    {
      "name": "Timer Pill"
    }
  ]
}
{% endschema %}
