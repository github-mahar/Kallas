<!-- blocks/_icon_text_feature.liquid -->
{%- liquid
  assign heading = block.settings.heading
  assign description = block.settings.description
  assign svg_upload = block.settings.svg_upload
  assign icon_position = block.settings.icon_position | default: 'left'
  assign icon_align_vertical = block.settings.icon_align_vertical | default: 'center'
  assign icon_gap = block.settings.icon_gap 
  assign text_gap = block.settings.text_gap 
  assign has_icon = false
  if svg_upload != blank or block.settings.image != blank
    assign has_icon = true
  elsif block.settings.icon != 'none' and block.settings.icon != blank
    assign has_icon = true
  endif
-%}

{%- capture css -%}
  {%- if block.settings.heading_size == "h_custom" -%}
    --heading-fs-lg: {{ block.settings.font_size_heading_lg }}px; --heading-fs-mb: {{ block.settings.font_size_heading }}px;
  {%- endif -%}
  {%- if block.settings.text_size == "custom" -%}
    --text-custom-lg: {{ block.settings.font_size_text_lg }}px; --text-custom-mb: {{ block.settings.font_size_text }}px;
  {%- endif -%}
{%- endcapture -%}

<div id="block-{{ block.id }}" class="hdt-icon-feature-block hdt-flex hdt-icon-pos-{{ icon_position }} hdt-icon-align-{{ icon_align_vertical }}{% if block.settings.enable_border_bottom %} hdt-has-border-bottom{% endif %}" {{ block.shopify_attributes }} style="gap: {{ icon_gap }}px;{% if css != blank %} {{ css }}{% endif %}" reval>
  {%- if block.settings.link != blank -%}
    <a href="{{ block.settings.link }}" target="{{ block.settings.target | default: '_self' }}" class="hdt-full-width-link" aria-label="{{ heading | escape }}"></a>
  {%- endif -%}

  {%- if has_icon -%}
    <div class="hdt-icon-feature-circle hdt-flex hdt-align-center hdt-justify-center hdt-relative hdt-flex-shrink-0">
      {%- if svg_upload != blank -%}
        {{ svg_upload }}
      {%- elsif block.settings.image != blank -%}
        {{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', class: 'hdt-object-contain' }}
      {%- elsif block.settings.icon != 'none' and block.settings.icon != blank -%}
        {%- render 'icons', icon: block.settings.icon -%}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="hdt-icon-feature-content hdt-flex hdt-flex-col" style="gap: {{ text_gap }}px;">
    {%- if heading != blank -%}
      <h4 class="hdt-icon-feature-heading hdt-s-text hdt-font-1 hdt-font-{{ block.settings.heading_font_weight | default: 'bold' }} hdt-{{ block.settings.heading_size | default: 'base' }} {{ block.settings.heading_line_height }}">
        {{ heading }}
      </h4>
    {%- endif -%}

    {%- if description != blank -%}
      <p class="hdt-icon-feature-des hdt-font-{{ block.settings.description_font_weight | default: 'normal' }} hdt-text-{{ block.settings.text_size | default: 'sm' }} {{ block.settings.description_line_height }}">
        {{ description }}
      </p>
    {%- endif -%}
  </div>
</div>

{%- style -%}
#block-{{ block.id }} {
  position: relative;
  display: flex;
}
#block-{{ block.id }}.hdt-has-border-bottom {
  border-bottom: 1px solid {{ block.settings.border_bottom_color | default: 'rgba(255, 255, 255, 0.4)' }};
  padding-bottom: {{ block.settings.border_bottom_pb | default: 15 }}px;
  margin-bottom: {{ block.settings.border_bottom_mb | default: 15 }}px;
  width: 100%;
}
#block-{{ block.id }}.hdt-icon-pos-left {
  flex-direction: row;
}
#block-{{ block.id }}.hdt-icon-pos-right {
  flex-direction: row-reverse;
}
#block-{{ block.id }}.hdt-icon-pos-top {
  flex-direction: column;
  align-items: center;
}
#block-{{ block.id }}.hdt-icon-pos-left.hdt-icon-align-center,
#block-{{ block.id }}.hdt-icon-pos-right.hdt-icon-align-center {
  align-items: center;
}
#block-{{ block.id }}.hdt-icon-pos-left.hdt-icon-align-start,
#block-{{ block.id }}.hdt-icon-pos-right.hdt-icon-align-start {
  align-items: flex-start;
}
#block-{{ block.id }}.hdt-icon-pos-left.hdt-icon-align-end,
#block-{{ block.id }}.hdt-icon-pos-right.hdt-icon-align-end {
  align-items: flex-end;
}
#block-{{ block.id }} .hdt-icon-feature-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: {{ block.settings.svg_size | default: 24 }}px;
  height: {{ block.settings.svg_size | default: 24 }}px;
  min-width: {{ block.settings.svg_size | default: 24 }}px;
  min-height: {{ block.settings.svg_size | default: 24 }}px;
  color: rgb(var(--color-foreground, 30, 30, 30));
  {%- if block.settings.enable_icon_border -%}
    border: {{ block.settings.icon_border_width | default: 1 }}px solid {{ block.settings.icon_border_color | default: '#000000' }};
    border-radius: {{ block.settings.icon_border_radius | default: 8 }}px;
    padding: {{ block.settings.icon_border_padding | default: 12 }}px;
    box-sizing: content-box;
    {%- if block.settings.icon_bg_color != blank and block.settings.icon_bg_color != 'transparent' -%}
      background-color: {{ block.settings.icon_bg_color }};
    {%- endif -%}
  {%- endif -%}
}
#block-{{ block.id }} .hdt-icon-feature-circle > svg,
#block-{{ block.id }} .hdt-icon-feature-circle > img,
#block-{{ block.id }} .hdt-icon-feature-circle svg {
  width: 100%;
  height: 100%;
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}
#block-{{ block.id }} .hdt-icon-feature-content {
  text-align: start;
  width: 100%;
}
#block-{{ block.id }}.hdt-icon-pos-top .hdt-icon-feature-content {
  text-align: center;
}
#block-{{ block.id }} .hdt-icon-feature-heading,
#block-{{ block.id }} .hdt-icon-feature-des {
  width: 100%;
  text-align: inherit;
}
#block-{{ block.id }} .hdt-icon-feature-heading {
  color: rgb(var(--color-foreground));
  margin: 0;
}
#block-{{ block.id }} .hdt-icon-feature-heading.hdt-h_custom {
  font-size: var(--heading-fs-lg, 16px);
}
#block-{{ block.id }} .hdt-icon-feature-des {
  color: rgb(var(--color-foreground2, 100, 100, 100));
  margin: 0;
}
#block-{{ block.id }} .hdt-icon-feature-des.hdt-text-custom {
  font-size: var(--text-custom-lg, 14px);
}

@media (max-width: 767px) {
  #block-{{ block.id }}.hdt-icon-pos-top .hdt-icon-feature-content {
    text-align: center;
  }
  #block-{{ block.id }} .hdt-icon-feature-heading.hdt-h_custom {
    font-size: var(--heading-fs-mb, 14px);
  }
  #block-{{ block.id }} .hdt-icon-feature-des.hdt-text-custom {
    font-size: var(--text-custom-mb, 12px);
  }
}
{%- endstyle -%}

