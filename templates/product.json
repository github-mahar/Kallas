                "accordion_delivery": {
                  "type": "_accordion_html_item",
                  "settings": {
                    "title": "DELIVERY TIME",
                    "icon": "none",
                    "content": "<p><strong>Shipment Processing Time:</strong><br>All orders are processed after confirmation. Delivery timelines may vary during sale periods, festive seasons, or new collection launches.</p><ol><li>Local Shipping (Pakistan).</li><li>Unstitched Dresses: Delivered within 5 - 7 working days.</li><li>Stitched Dresses: Dispatched in 10 - 12 working days.</li><li>Ready-to-Wear (Pret): Delivered within 7 - 10 working days.</li></ol><p><strong>International Shipping</strong></p><ol><li>Unstitched Dresses: Delivered within 10 - 15 working days.</li><li>Stitched Dresses: Delivered within 10 – 20 working days.</li><li>Ready-to-Wear (Pret): Delivered within 10 - 18 working days.</li></ol><p><strong>Delivery timelines begin once the order has been successfully confirmed.</strong></p>"
                  }
                },
                "accordion_care": {
                  "type": "_accordion_html_item",
                  "settings": {
                    "title": "CARE GUIDE",
                    "icon": "none",
                    "content": "<ol><li>Dry clean recommended.</li><li>Do not use bleach or strong stain removers.</li><li>Iron on medium heat.</li><li>Avoid high heat.</li><li>Do not use harsh chemicals.</li><li>Hand wash only</li><li>Hand wash gently if needed.</li><li>Do not twist or squeeze.</li><li>Air dry in a cool, shaded place.</li></ol><p><strong>Note:</strong><br>Actual colors may look slightly different due to lighting and photography. Some accessories or embellishments shown in photos are for styling only and are not included with the outfit.</p>"
                  }
                },
                "accordion_disclaimer": {
                  "type": "_accordion_html_item",
                  "settings": {
                    "title": "DISCLAIMER",
                    "icon": "none",
                    "content": "<p>We do our best to show our products clearly, but please note that colors, fabric texture, and size may vary slightly due to screen settings and production.</p><p>For exact details about size, fabric, and care, please check the product description. If you need urgent delivery, contact our customer support before placing your order.</p><p><strong>Stitched items:</strong> Include the stitched outfit with trousers and any accessories mentioned. <strong>Unstitched items:</strong> Only include the fabric as described, no accessories are included.</p>"
                  }
                }
              },
